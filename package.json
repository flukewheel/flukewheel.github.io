{
  "name": "flukewheel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=11.9.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @flukewheel/web",
    "build": "npm run build --workspace @flukewheel/web",
    "check:bundle-secrets": "node scripts/check-public-bundle.mjs",
    "lint": "npm run lint --workspace @flukewheel/web",
    "typecheck": "npm run typecheck --workspace @flukewheel/contracts && npm run typecheck --workspace @flukewheel/web",
    "test": "npm run test:deno-imports && npm run test --workspace @flukewheel/contracts && npm run test --workspace @flukewheel/web",
    "test:deno-imports": "node scripts/verify-edge-imports.mjs",
    "test:e2e": "npm run test:e2e --workspace @flukewheel/web"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}
